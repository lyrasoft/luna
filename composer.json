{
    "name": "lyrasoft/luna",
    "description": "A CMF package for Windwalker.",
    "homepage": "https://github.com/lyrasoft/luna",
    "license": "MIT",
    "minimum-stability": "beta",
    "require": {
        "php": ">=8.4.6",
        "windwalker/core": "^4.2",
        "windwalker/unicorn": "^1.2",
        "windwalker/crypt": "^4.2",
        "scssphp/scssphp": "^1.0",
        "symfony/polyfill-intl-idn": "^1.23",
        "firebase/php-jwt": "^5.4||^6.0||^7.0"
    },
    "require-dev": {
        "windwalker/framework": "dev-master",
        "windwalker/core": "dev-master",
        "windwalker/unicorn": "dev-main",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4",
        "gregwar/captcha": "^2.1",
        "google/recaptcha": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "test:app": "phpunit -c phpunit.app.xml",
        "cs-check": "bin/cs-fixer.php check --diff",
        "cs-fix": "bin/cs-fixer.php fix",
        "prepare-hooks": "git config core.hooksPath .githooks",
        "remove-hooks": "git config --local --unset core.hooksPath"
    },
    "suggest": {
        "hybridauth/hybridauth": "Install ^3.0 to support social login.",
        "thl/pinyin": "Install ^1.2 to support pinyin alias.",
        "gregwar/captcha": "Install ^1.1 to support Image Captcha",
        "google/recaptcha": "Install ^1.2 to support Google Re-Captcha"
    },
    "autoload": {
        "psr-4": {
            "Lyrasoft\\Luna\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Lyrasoft\\Luna\\Tests\\": "tests/"
        }
    },
    "extra": {
        "windwalker":{
            "packages": [
                "Lyrasoft\\Luna\\LunaPackage"
            ],
            "modules": [
                "src/Module"
            ],
            "assets": {
                "vendors": {
                    "@lyrasoft/luna": "portal:./vendor/lyrasoft/luna/assets"
                },
                "exposes": [
                    "@windwalker-io/srp",
                    "@lyrasoft/luna",
                    "wowjs",
                    "wow.js",
                    "animate.css",
                    "jarallax"
                ]
            }
        },
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    }
}
