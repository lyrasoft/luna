<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    bootstrap="tests/bootstrap.app.php"
    colors="false"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.2/phpunit.xsd"
    cacheDirectory=".phpunit.cache"
>
	<php>
		<ini name="error_reporting" value="-1" />

        <!--
            Host app mode: run from vendor/lyrasoft/luna using the host's vendor/ and
            Runtime. Copy to phpunit.xml, then run `vendor/bin/phpunit -c phpunit.xml`
            from this directory (use the host's vendor/bin/phpunit).
        -->
		<env name="WINDWALKER_TEST_APP_ROOT" value="../../.." />

        <!--
            MySQL DSN used by database tests. The database is DROPPED and recreated on
            every run: NEVER point this at the host app's real database.
        -->
        <env name="WINDWALKER_TEST_DB_DSN" value="pdo_mysql:host=127.0.0.1;port=3306;dbname=luna_test_field_categorylist;user=root;password=;prefix=luna_" />
	</php>

	<testsuites>
		<testsuite name="Unit">
			<file>tests/Field/CategoryListFieldTest.php</file>
		</testsuite>
	</testsuites>

    <source ignoreIndirectDeprecations="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
