<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    bootstrap="tests/bootstrap.app.php"
    colors="false"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.2/phpunit.xsd"
    cacheDirectory=".phpunit.cache"
>
	<php>
		<ini name="error_reporting" value="-1" />

        <!--
            MySQL DSN used by database tests. The database is DROPPED and recreated on
            every run, so use a disposable one. An environment variable with the same
            name takes precedence over this value.
        -->
        <env name="WINDWALKER_TEST_DB_DSN" value="pdo_mysql:host=127.0.0.1;port=3306;dbname=luna_test;user=root;password=;prefix=luna_" />
	</php>

	<testsuites>
		<testsuite name="Unit">
			<directory>tests</directory>
		</testsuite>
	</testsuites>

    <source ignoreIndirectDeprecations="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
